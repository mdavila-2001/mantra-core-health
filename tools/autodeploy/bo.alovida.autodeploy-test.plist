<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Agente de usuario que vigila `origin/test` (front y API) y redespliega las
  dos apps del VPS. Hermano de bo.alovida.autodeploy (que vigila `mockup`);
  no lo reemplaza.

  Instalar:
    launchctl load -w ~/Library/LaunchAgents/bo.alovida.autodeploy-test.plist
  Quitar:
    launchctl unload -w ~/Library/LaunchAgents/bo.alovida.autodeploy-test.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>bo.alovida.autodeploy-test</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/josejeremias/.local/bin/alovida-autodeploy-test.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>180</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/josejeremias/.local/state/alovida-autodeploy-test/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/josejeremias/.local/state/alovida-autodeploy-test/launchd.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
