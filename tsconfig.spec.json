/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    /* La preparación compartida también se type-chequea: sin esto el compilador
       la incluye en el bundle pero no la revisa, y un error ahí aparecería
       recién en tiempo de ejecución. */
    "src/test-setup.ts",
    /* Ídem para los ayudantes compartidos entre specs. */
    "src/testing/**/*.ts"
  ]
}
