# Imagen de desarrollo: sirve `ng serve` con hot reload.
# Debian slim y no Alpine porque las dependencias nativas del build de Angular
# (esbuild, rolldown, lightningcss, lmdb) publican binarios contra glibc.
FROM node:24-bookworm-slim

# Corepack instala la versión de Yarn fijada en el campo `packageManager`.
RUN corepack enable

WORKDIR /app

# Solo manifiesto, lockfile y configuración de Yarn primero: la capa de
# instalación se reutiliza mientras esos archivos no cambien.
#
# `.yarnrc.yml` va acá y no en el `COPY . .` de abajo porque lo necesita el
# `yarn install` de la línea siguiente: lleva `npmMinimalAgeGate: 0`, y sin él
# Yarn 4.18 aplica su espera mínima antes de instalar paquetes recién
# publicados y la instalación puede fallar.
COPY package.json yarn.lock .yarnrc.yml ./

# El repo no fija `nodeLinker`, así que Yarn 4 instala en modo PnP y genera
# .pnp.cjs y .yarn/unplugged con binarios nativos de ESTA plataforma (linux).
# Por eso se instala acá adentro y .dockerignore excluye los del host.
RUN yarn install --immutable

COPY . .

EXPOSE 4200

# Origen del backend al que el proxy reenvía /iam, /public, /terminology…
# Dentro del contenedor `localhost` es el contenedor, así que el default apunta
# al host. Se sobreescribe por entorno (ver .env.example).
ENV BACKEND_ORIGIN=http://host.docker.internal:3000
# A dónde reenvía el proxy las trazas del navegador (/otel/**). El valor por
# defecto apunta al host: el Collector se levanta con
# infra/otel-collector/docker-compose.observability.yml, que es otro compose.
ENV COLLECTOR_ORIGIN=http://host.docker.internal:4318

# Raíz de la API que usa el navegador. Vacía = rutas relativas, que es lo que
# corresponde acá: las resuelve el proxy de arriba. Solo se define si el
# navegador tuviera que hablar con otro dominio. Ver .env.example.
ENV PUBLIC_API_BASE_URL=""

# El proxy de Angular es un JSON estático y no interpola variables, así que el
# origen se sustituye al arrancar sobre la plantilla y se sirve el resultado.
# Se genera en un archivo aparte para no chocar con el proxy.conf.json del repo,
# que es el del host y no debe cambiar.
#
# --host 0.0.0.0 para que el puerto sea alcanzable fuera del contenedor.
# --poll porque los bind mounts de Docker Desktop en macOS no propagan eventos
# fsevents, y sin polling el hot reload no se entera de los cambios.
#
# El `ng serve` se invoca directo y no por `yarn start`, así que el entorno del
# navegador se genera acá explícitamente: `src/environments/env.generated.ts`
# no viaja en la imagen (no se versiona) y sin él la compilación no resuelve el
# import. Se genera con el entorno del contenedor, que docker-compose alinea
# con el mismo `.env` que usa el host.
CMD ["sh", "-c", "sed -e \"s|__BACKEND_ORIGIN__|$BACKEND_ORIGIN|\" -e \"s|__COLLECTOR_ORIGIN__|$COLLECTOR_ORIGIN|\" proxy.conf.docker.json > proxy.generated.json && node scripts/generate-env.mjs && exec yarn ng serve --proxy-config proxy.generated.json --host 0.0.0.0 --port 4200 --poll 2000"]
