# =========================================================================
# Mantra Core Technologies · REDESA Health Ecosystem — Frontend
# Plantilla de entorno — copiar a .env y ajustar. Valores de desarrollo.
# No poner secretos acá: este archivo llega al navegador por definición.
#
# OJO, esto es un frontend Angular y funciona distinto al repo de la API:
# Angular no lee .env por su cuenta. Las variables `PUBLIC_*` de abajo las
# traduce `scripts/generate-env.mjs` a `src/environments/env.generated.ts`
# antes de cada `yarn start`, `build`, `watch` y `test`; el resto lo consumen el
# servidor de SSR y docker-compose, que leen el entorno directo.
#
# Todas las variables tienen valor por defecto: sin .env el proyecto levanta
# igual. Este archivo existe para poder cambiarlas sin editar código.
#
# NADA de lo que se ponga en una variable `PUBLIC_*` es secreto: se compila
# dentro del JavaScript que descarga el navegador y se lee con abrir las
# herramientas de desarrollo. El generador rechaza lo que parezca credencial
# (nombres tipo SECRET/PASSWORD/TOKEN/KEY, JWTs, claves PEM, URLs con
# usuario:contraseña@) para que el error salte al compilar y no en producción.
# Lo que necesite ser secreto va en el .env de la API, que no llega al cliente.
# =========================================================================


# --- Aplicación en el navegador (variables PUBLIC_*) -------------------------
# Las lee `scripts/generate-env.mjs` y terminan compiladas en el paquete.
# Son las únicas que cruzan del entorno al código del cliente: el generador
# tiene una lista fija (su MANIFIESTO) y no mira ninguna otra clave de este
# archivo, así que agregar variables acá no expone nada por accidente.

# Raíz de la API a la que pide el navegador.
#
# VACÍO (el valor recomendado, y el de por defecto) = rutas relativas: la
# aplicación pide a `/iam/...` sobre su propio origen, y eso lo resuelve el
# proxy en desarrollo o el mismo servidor web en un despliegue. Sin CORS y sin
# el dominio de la API quemado en el paquete.
#
# Solo se define si la API vive en otro dominio, y entonces va la raíz completa
# y absoluta: https://api.ejemplo.com. Sin barra final, sin query, sin
# fragmento y sin credenciales en la URL — el generador aborta si las lleva.
PUBLIC_API_BASE_URL=


# --- Servidor de SSR (producción) --------------------------------------------
# Puerto en el que escucha el Express de `src/server.ts`, el que sirve la
# aplicación ya construida (`yarn serve:ssr:mantra-core-health`).
# Es la ÚNICA variable de entorno que lee el código de este repo (server.ts:55).
# No afecta a `yarn start`: el dev server usa el 4200 de angular.json.
PORT=4000


# --- Docker Compose ----------------------------------------------------------
# Solo las lee `docker-compose.yml`. Compose toma el `.env` de esta carpeta.

# Puerto del host donde queda publicado el dev server. Cambialo si el 4200 ya
# está ocupado; adentro del contenedor sigue siendo 4200.
FRONTEND_PORT=4200

# Origen al que el proxy reenvía /iam, /public, /terminology, /profiles,
# /identity y /common (la lista está en `proxy.conf.docker.json`).
#
# `host.docker.internal` es el host visto desde el contenedor: es lo correcto
# mientras la API corra con `yarn start:prod` en tu máquina. Dentro del
# contenedor `localhost` sería el contenedor mismo, y el proxy no encontraría
# nada.
#
# Si algún día la API corre como otro servicio del mismo compose, acá va el
# nombre de ese servicio (p. ej. http://api:3000).
BACKEND_ORIGIN=http://host.docker.internal:3000


# =========================================================================
# Lo que NO se configura acá, y dónde vive
# =========================================================================
#
# Los valores por defecto de la aplicación (los que se usan si no hay .env)
#   → src/environments/environment.ts            (producción)
#   → src/environments/environment.development.ts (desarrollo)
#   `angular.json` intercambia uno por el otro con `fileReplacements`. Ninguno
#   de los dos guarda valores concretos: solo el respaldo de lo que no venga
#   por entorno. Los valores reales entran por `PUBLIC_*` (arriba), que el
#   generador deja en `src/environments/env.generated.ts` — archivo generado,
#   fuera del control de versiones, no se edita a mano.
#
# El proxy del host (`yarn start` sin Docker)
#   → proxy.conf.json — JSON estático, apunta a localhost:3000.
#     La variante del contenedor es proxy.conf.docker.json.
#
# Credenciales de la cuenta de demostración
#   → las siembra la API con BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD
#     en el .env del repo mantra-core-health-redesa-api, no acá.
