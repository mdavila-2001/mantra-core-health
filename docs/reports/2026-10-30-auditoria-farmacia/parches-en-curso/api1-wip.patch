+/**
+ * Los tramos de una ruta que la redacción reemplazó por `[token]`, tal como
+ * llegaron (con sus códigos `%XX`) y decodificados. Sirven para buscar el mismo
+ * token en OTROS campos de la petición que lo repiten con otra forma, como
+ * `req.params.path` (el array de segmentos que Express arma para el comodín de
+ * `nestjs-pino`), `req.path` o `req.originalUrl`.
+ *
+ * @param url - Ruta o URL de la petición (con o sin query).
+ * @returns Los tramos sustituidos; vacío si la ruta no lleva ningún token.
+ */
+export function shareTokenSegmentsOf(url: string): string[] {
+  const cut = url.search(/[?#]/);
+  const path = cut === -1 ? url : url.slice(0, cut);
+  const redacted = redactShareTokenInUrl(path);
+  if (redacted === path) return [];
+  const before = path.split(SEGMENT_SEPARATOR);
+  const after = redacted.split(SEGMENT_SEPARATOR);
+  const found = new Set<string>();
+  for (let index = 0; index < before.length; index += 2) {
+    const segment = before[index];
+    if (segment === '' || segment === after[index]) continue;
+    found.add(segment);
+    found.add(normalizedSegment(segment));
+  }
+  return [...found].filter((segment) => segment !== '');
+}
+
+/**
