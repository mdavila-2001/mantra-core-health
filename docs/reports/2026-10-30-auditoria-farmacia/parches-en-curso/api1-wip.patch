+/**
+ * Copia de `value` sin ningún token de enlace compartido: cada cadena pasa por
+ * `redactShareTokenInUrl` y se le quitan los `tokens` conocidos de la petición,
+ * en cualquier campo y a cualquier profundidad (objetos y arrays). No muta el
+ * original (los handlers de Express lo siguen leyendo) y devuelve la misma
+ * referencia si nada cambió.
+ *
+ * @param value - Lo serializado de la petición.
+ * @param tokens - Tramos sustituidos, de `shareTokenSegmentsOf`.
+ * @param depth - Profundidad restante; protege de estructuras cíclicas.
+ * @returns El valor sin token en claro.
+ */
+export function redactShareTokensDeep<T>(
+  value: T,
+  tokens: readonly string[],
+  depth = 6,
+): T {
+  if (typeof value === 'string') {
+    let text: string = redactShareTokenInUrl(value);
+    for (const token of tokens) {
+      if (text === token) {
+        text = REDACTED_SHARE_TOKEN;
+      } else if (token.length >= SUBSTRING_MIN_LENGTH && text.includes(token)) {
+        text = text.split(token).join(REDACTED_SHARE_TOKEN);
+      }
+    }
+    return (text === value ? value : text) as T;
+  }
+  if (value === null || typeof value !== 'object' || depth <= 0) return value;
+  if (Array.isArray(value)) {
+    const list: unknown[] = value;
+    const items = list.map((item) =>
