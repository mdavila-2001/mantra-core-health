{
  "name": "mantra-core-health",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "env:generate": "node scripts/generate-env.mjs",
    "config:env": "yarn env:generate",
    "start": "yarn env:generate && ng serve",
    "build": "yarn env:generate && ng build",
    "watch": "yarn env:generate && ng build --watch --configuration development",
    "test": "yarn env:generate && ng test",
    "test:coverage": "yarn env:generate && ng test --coverage --watch=false",
    "serve:ssr:mantra-core-health": "node dist/mantra-core-health/server/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p e2e/selenium/tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:e2e": "node scripts/run-e2e-selenium.mjs",
    "test:e2e:smoke": "node scripts/run-e2e-selenium.mjs --suite smoke",
    "test:e2e:critical": "node scripts/run-e2e-selenium.mjs --suite critica",
    "test:e2e:regression": "node scripts/run-e2e-selenium.mjs --suite regresion",
    "test:e2e:responsive": "node scripts/run-e2e-selenium.mjs --suite responsive",
    "test:e2e:headed": "E2E_HEADLESS=false E2E_WORKERS=1 node scripts/run-e2e-selenium.mjs",
    "test:e2e:headless": "E2E_HEADLESS=true node scripts/run-e2e-selenium.mjs",
    "test:e2e:report": "node scripts/generate-e2e-report.mjs"
  },
  "private": true,
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/selenium-webdriver": "^4",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "selenium-webdriver": "^4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.8"
  }
}
