{
  "name": "mantra-core-health",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "env:generate": "node scripts/generate-env.mjs",
    "config:env": "yarn env:generate",
    "start": "yarn env:generate && ng serve",
    "build": "yarn env:generate && ng build",
    "watch": "yarn env:generate && ng build --watch --configuration development",
    "test": "yarn env:generate && ng test",
    "test:coverage": "yarn env:generate && ng test --coverage --watch=false",
    "serve:ssr:mantra-core-health": "node dist/mantra-core-health/server/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p cypress/tsconfig.json --noEmit",
    "e2e": "cypress run --e2e --browser chrome",
    "e2e:open": "cypress open --e2e --browser chrome",
    "test:e2e": "cypress run --e2e --browser chrome",
    "test:e2e:smoke": "cypress run --e2e --browser chrome --spec \"cypress/e2e/smoke/**/*.cy.ts\"",
    "test:e2e:critical": "cypress run --e2e --browser chrome --spec \"cypress/e2e/{smoke,authentication,navigation,forms}/**/*.cy.ts\"",
    "test:e2e:regression": "cypress run --e2e --browser chrome --spec \"cypress/e2e/regression/**/*.cy.ts\"",
    "test:e2e:responsive": "cypress run --e2e --browser chrome --spec \"cypress/e2e/responsive/**/*.cy.ts\"",
    "recorrido": "node scripts/run-recorrido.mjs",
    "recorrido:real": "node scripts/run-recorrido-real.mjs",
    "recorrido:report": "node scripts/generate-recorrido-report.mjs"
  },
  "private": true,
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.11",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "axe-core": "^4.12.1",
    "cypress": "^15.20.0",
    "eslint": "^10.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.8"
  }
}
