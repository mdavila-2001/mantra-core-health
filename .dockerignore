# Artefactos de instalación de Yarn generados en el host (darwin-arm64).
# Si entraran al contexto, el `COPY . .` pisaría los que genera `yarn install`
# dentro de la imagen, que son de linux. Es la causa más común de que el
# contenedor falle con "Could not find the builder's node package".
.pnp.*
.yarn/unplugged
.yarn/install-state.gz
.yarn/cache
node_modules

# Salidas de build y cachés: se regeneran dentro del contenedor.
dist
.angular
coverage
out-tsc

# Entorno del navegador generado en el host: el contenedor lo regenera al
# arrancar con SU propio entorno, y el del host podría apuntar a otra API.
src/environments/env.generated.ts

# El entorno real nunca entra a la imagen: las variables se pasan en ejecución
# (docker-compose las inyecta). La plantilla sí, que es solo documentación.
.env
.env.*
!.env.example

# Evidencia, documentación y pruebas: el build no lee nada de acá (la app
# compila solo `src/**`, y `env:generate` / `stock:generate` no los tocan).
# Eran 350 de los 380 MB del contexto: en cada despliegue Docker los
# empaquetaba y el `COPY . .` los copiaba y los hasheaba enteros.
evidencias
docs
playwright
playwright-report
test-results
cypress
*.pdf

.git
.gitignore
.vscode
.idea
*.md
Dockerfile.dev
docker-compose.yml
.DS_Store
