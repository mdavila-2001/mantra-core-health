/* Configuración de tipos de la suite de Selenium.

   Es propia y no una extensión de `tsconfig.spec.json` porque el alcance es el
   opuesto: esto NO corre en el navegador ni conoce el `TestBed` de Angular.
   Corre en Node, conduce un navegador desde afuera y necesita los tipos de
   Node y de Vitest, no los del DOM de la aplicación.

   Se type-chequea en `yarn typecheck` y en el pipeline: un Page Object que
   quedó apuntando a un método que ya no existe tiene que fallar al compilar,
   no a mitad de una corrida de veinte minutos. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/e2e-selenium",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    /* Los scripts que se inyectan en la página se escriben como texto y sus
       resultados llegan sin tipo: `executeScript<T>()` los afirma. Con esto,
       afirmar de más sigue siendo un error de compilación. */
    "allowJs": false,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["../../node_modules"]
}
