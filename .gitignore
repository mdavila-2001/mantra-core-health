# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# Entorno local. La plantilla `.env.example` SÍ va al repo; el `.env` real no.
.env
.env.*
!.env.example

# Proxy generado por el contenedor a partir de proxy.conf.docker.json.
proxy.generated.json

# Yarn 4 — artefactos generados por la instalación.
# El repo no fija `nodeLinker`, así que Yarn instala en modo PnP y genera estos
# archivos: cientos de dependencias desempaquetadas, binarios incluidos. Son
# producto de `yarn install` y se regeneran solos; no van al repositorio.
.pnp.*
.yarn/install-state.gz
.yarn/unplugged/
.yarn/cache/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db

# Hosts and secrets
.env
.env.*
src/environments/environment.ts
src/environments/environment.development.ts
src/environments/environment.types.ts