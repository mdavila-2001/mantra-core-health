# =========================================================================
# Mantra Core Technologies · REDESA Health Ecosystem — Frontend
# Plantilla de entorno de las pruebas de extremo a extremo con Cypress.
#
# Copiar a `.env.e2e` y ajustar SOLO lo que haga falta: todas las variables
# tienen valor por defecto y la suite corre sin ninguna de ellas.
#
#   yarn test:e2e            # la suite funcional completa
#   yarn test:e2e:smoke      # solo humo
#   yarn test:e2e:critical   # humo + autenticación + navegación + formularios
#   yarn e2e:open            # el modo interactivo, para escribir pruebas
#   yarn recorrido           # el recorrido visual (cientos de capturas)
#   yarn recorrido:real      # el recorrido contra la API viva
#
# Ninguna variable de acá es un secreto ni puede serlo: la API de la suite
# funcional está simulada por el propio arnés (`cypress/harness/`) y acepta
# cualquier credencial. Las de usuario existen para cuando la suite se apunta a
# un entorno de ensayo real con `E2E_BASE_URL`, y en ese caso el archivo
# `.env.e2e` NO se versiona: está cubierto por `.gitignore`.
# =========================================================================


# --- Contra qué se prueba ----------------------------------------------------

# Raíz de la aplicación.
#
# VACÍO (lo recomendado) = la suite construye el artefacto de producción, lo
# sirve ella misma con la API simulada delante y prueba contra eso. Es la única
# forma de que el prerenderizado y las cabeceras de seguridad —que solo existen
# en el artefacto— entren en la prueba.
#
# Con un valor, la suite NO levanta nada y prueba contra ese servidor. Fuera de
# la máquina local hace falta además E2E_ALLOW_REMOTE=true, a propósito.
E2E_BASE_URL=

# Puerto en el que escucha el arnés cuando la suite levanta su propio servidor.
# Se cambia si el 4175 ya está ocupado.
E2E_PORT=4175

# Permite apuntar a un servidor que no sea local. Es una barrera deliberada:
# estas pruebas dan de alta cuentas y cierran sesiones, y contra un entorno real
# eso es daño, no una prueba. Nunca contra producción.
E2E_ALLOW_REMOTE=false


# --- Tiempos -----------------------------------------------------------------

# Techo de las esperas de Cypress, en milisegundos. NO es el mecanismo de
# sincronización —Cypress reintenta cada aserción por su cuenta— sino el límite
# por encima del cual algo está claramente roto.
E2E_TIMEOUT=15000

# `true` reutiliza el artefacto que ya esté en `dist/` en vez de reconstruirlo.
# Acelera el ciclo de escribir pruebas; NUNCA en CI, donde un `dist/` viejo haría
# pasar pruebas sobre código que ya no existe.
#
# El arnés solo reutiliza el artefacto si lo construyó él: deja una marca en
# `dist/mantra-core-health/.arnes-e2e` porque un `yarn build` a mano toma la
# `API_BASE_URL` del `.env` y produce un paquete que le habla al backend real,
# con el que la API simulada no ve una sola petición.
E2E_SKIP_BUILD=false


# --- Ventana -----------------------------------------------------------------

# Resolución por defecto. Las pruebas responsive fijan la suya con `cy.viewport()`
# y no leen esto.
E2E_VIEWPORT_WIDTH=1440
E2E_VIEWPORT_HEIGHT=900


# --- Evidencias --------------------------------------------------------------

# Carpeta raíz de las evidencias de la suite funcional. Cada corrida crea la
# suya con marca de tiempo y todo el árbol está en `.gitignore`.
E2E_ARTIFACTS_DIR=artifacts/cypress

# Carpeta de las capturas de los recorridos, dentro de `artifacts/`. La fijan
# `scripts/run-recorrido.mjs` (`recorrido`) y `scripts/run-recorrido-real.mjs`
# (`real`) para que no se pisen entre sí; no hace falta tocarla a mano.
EVIDENCIAS_DIR=recorrido


# --- Datos de prueba ---------------------------------------------------------
#
# Con la API simulada da igual qué se ponga: el escenario decide si el login es
# válido, no las credenciales. Estas variables son para el caso de un entorno de
# ensayo real, y ahí SÍ son credenciales: no se escriben en este archivo de
# ejemplo ni en el repositorio.
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
E2E_TEST_USER_NATIONAL_ID=


# --- Recorrido con usuarios reales -------------------------------------------
#
# Solo los usa `yarn recorrido:real`, que es la única suite sin nada simulado:
# crea los actores contra la API viva y necesita el backend levantado.
E2E_API_URL=http://localhost:3000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
