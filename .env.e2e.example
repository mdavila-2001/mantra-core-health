# =========================================================================
# Mantra Core Technologies · REDESA Health Ecosystem — Frontend
# Plantilla de entorno de las pruebas de extremo a extremo con Selenium.
#
# Copiar a `.env.e2e` y ajustar SOLO lo que haga falta: todas las variables
# tienen valor por defecto y la suite corre sin ninguna de ellas.
#
#   yarn test:e2e            # la suite completa
#   yarn test:e2e:smoke      # solo humo
#   yarn test:e2e:critical   # humo + autenticación + navegación + formularios
#
# Ninguna variable de acá es un secreto ni puede serlo: la API de la suite está
# simulada por el propio arnés (`e2e/selenium/harness/`) y acepta cualquier
# credencial. Las dos variables de usuario existen para cuando la suite se
# apunta a un entorno de ensayo real con `E2E_BASE_URL`, y en ese caso el
# archivo `.env.e2e` NO se versiona: está cubierto por `.gitignore`.
# =========================================================================


# --- Contra qué se prueba ----------------------------------------------------

# Raíz de la aplicación.
#
# VACÍO (lo recomendado) = la suite construye el artefacto de producción, lo
# sirve ella misma con la API simulada delante y prueba contra eso. Es la única
# forma de que el prerenderizado y las cabeceras de seguridad —que solo existen
# en el artefacto— entren en la prueba.
#
# Con un valor, la suite NO levanta nada y prueba contra ese servidor. Fuera de
# la máquina local hace falta además E2E_ALLOW_REMOTE=true, a propósito.
E2E_BASE_URL=

# Puerto en el que escucha el arnés cuando la suite levanta su propio servidor.
# Se cambia si el 4175 ya está ocupado. No es el 4173 de Playwright: las dos
# suites tienen que poder correr a la vez.
E2E_PORT=4175

# Permite apuntar a un servidor que no sea local. Es una barrera deliberada:
# estas pruebas dan de alta cuentas y cierran sesiones, y contra un entorno real
# eso es daño, no una prueba. Nunca contra producción.
E2E_ALLOW_REMOTE=false


# --- Navegador ---------------------------------------------------------------

# `chrome` (por defecto) o `chromium`. Con `chromium`, el binario sale de
# CHROME_BIN o de /usr/bin/chromium: es lo que usan las imágenes de contenedor.
E2E_BROWSER=chrome

# `false` abre una ventana visible. Para depurar conviene además E2E_WORKERS=1,
# o se abren varias a la vez. Atajo: `yarn test:e2e:headed`.
E2E_HEADLESS=true

# Resolución por defecto. Las pruebas responsive fijan la suya y no leen esto.
E2E_VIEWPORT_WIDTH=1440
E2E_VIEWPORT_HEIGHT=900

# Fuentes web.
#
# Van DESHABILITADAS por defecto y no es una preferencia: con las fuentes de
# `@fontsource` cargando, el renderizador deja de responderle a ChromeDriver y
# la suite entera vence por tiempo. Ver `core/driver.factory.ts`, que documenta
# cómo se aisló. `true` las vuelve a habilitar para comprobar si una versión
# futura de Chrome lo arregla.
E2E_REMOTE_FONTS=false


# --- Tiempos y paralelismo ---------------------------------------------------

# Techo de las esperas explícitas, en milisegundos. NO es el mecanismo de
# sincronización —eso son las condiciones de `core/wait.helpers.ts`— sino el
# límite por encima del cual algo está claramente roto.
E2E_TIMEOUT=15000

# Archivos de prueba en paralelo. Cada prueba abre su propio navegador con
# perfil limpio, así que no se pisan. `1` hace la corrida secuencial, que es lo
# que conviene para depurar.
E2E_WORKERS=2

# `true` reutiliza el artefacto que ya esté en `dist/` en vez de reconstruirlo.
# Acelera el ciclo de escribir pruebas; NUNCA en CI, donde un `dist/` viejo
# haría pasar pruebas sobre código que ya no existe.
E2E_SKIP_BUILD=false


# --- Evidencias --------------------------------------------------------------

# Capturas, HTML de la página y registros del navegador cuando una prueba falla.
E2E_SCREENSHOT_ON_FAILURE=true

# Carpeta raíz de las evidencias. Cada corrida crea la suya con marca de tiempo
# y todo el árbol está en `.gitignore`.
E2E_ARTIFACTS_DIR=artifacts/selenium


# --- Datos de prueba ---------------------------------------------------------
#
# Con la API simulada da igual qué se ponga: el escenario decide si el login es
# válido, no las credenciales. Estas variables son para el caso de un entorno de
# ensayo real, y ahí SÍ son credenciales: no se escriben en este archivo de
# ejemplo ni en el repositorio.
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
E2E_TEST_USER_NATIONAL_ID=
