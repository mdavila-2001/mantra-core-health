# Variables del stack de la rama `mockup` — el `docker-compose.yml` de la raíz.
#
#   cp deploy/mockup.env.example .env
#   docker compose --env-file .env up -d --build
#
# Son las únicas dos. No hay secretos: la rama `mockup` no habla con ninguna
# API ni base de datos.

# El dominio (o IP) por el que se va a entrar, SIN https:// ni puerto. Es
# obligatorio para cualquier cosa que no sea `localhost`: el servidor de
# renderizado responde 400 a los `Host` que no conoce. Varios, separados por
# coma.
APP_DOMAIN=localhost

# Puerto del VPS donde se publica la aplicación. Con Coolify o cualquier proxy
# delante se puede ignorar: el contenedor expone el 4000 en la red de Docker.
HTTP_PORT=8080
