# =========================================================================
# Variables del recurso de Coolify del FRONTEND
# (`deploy/docker-compose.coolify.yml`).
#
# Se pegan en la pestaña «Environment Variables» del recurso; no se copian a
# un `.env` en el servidor.
# =========================================================================

# ─── OBLIGATORIA ──────────────────────────────────────────────────────────
# El dominio público, exactamente como lo escribe el navegador y como se
# configuró en Coolify. Sin esquema, sin barra final. Varios, separados por
# coma.
#
# El servidor de renderizado responde 400 a todo `Host` que no esté en esta
# lista —«Header "host" with value "…" is not allowed»—, así que sin ella el
# stack arranca en verde y devuelve 400 en cada página al primer visitante.
# El healthcheck no lo detecta: pide `localhost`, que sí está permitido.
APP_DOMAIN=alovida.example.bo

# ─── Red compartida con el stack de la API ────────────────────────────────
# OPCIONAL. La red la crea el stack del backend al desplegarse; acá solo se
# toma. Únicamente hace falta declarar esta variable si le cambiaste el nombre
# allá, y entonces tiene que valer lo mismo en los dos recursos.
# ALOVIDA_NETWORK=alovida
