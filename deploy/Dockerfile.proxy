# Imagen del reverse proxy del despliegue en Coolify.
#
# ─── Por qué existe esta imagen en vez de montar la configuración ────────────
#
# Hasta el 2026-09-14 el servicio `proxy` de `docker-compose.coolify.yml` traía
# los tres archivos de nginx por bind mount (`./deploy/nginx.coolify.conf` y
# compañía). Eso no puede funcionar en Coolify: el repositorio se clona DENTRO
# de un contenedor auxiliar (`/artifacts/<uuid>`) y el `docker compose up` se
# lanza contra el socket del HOST, donde esa ruta no existe. Docker crea el
# origen que falta como directorio vacío y runc se niega:
#
#   not a directory: Are you trying to mount a directory onto a file?
#
# El `web` llegaba a «healthy» y el despliegue moría igual, en el `proxy`.
#
# Lo que sí viaja bien a Coolify es el contexto de BUILD. Por eso la
# configuración entra en una imagen: se copia al construir, no se monta al
# arrancar.
#
# ─── El contexto es la RAÍZ del repositorio ──────────────────────────────────
#
# Las rutas de abajo llevan el prefijo `deploy/` a propósito. Coolify invoca
# compose con `--project-directory <raíz del repo>`, así que el `context: .` del
# compose es la raíz y no esta carpeta.
FROM nginx:1.27-alpine

# El enrutado completo: los prefijos de la API al `api:3000` de la red
# `alovida`, `/otel/` y todo lo demás al servidor de renderizado `web:4000`.
# `api-locations.conf` es el MISMO archivo que incluye el nginx de producción,
# para que los dos proxies no puedan divergir.
# Son TRES archivos y no dos. `api-locations.conf` incluye `api-proxy.conf` en
# cada una de sus ~60 reglas —las cabeceras de reenvío, que están una sola vez
# para que no puedan divergir entre rutas—, así que olvidarlo no rompe el build:
# rompe el ARRANQUE, con el despliegue ya dado por bueno y el proxy en bucle de
# reinicio mientras Coolify informa «finished» (despliegue 719, 17/09).
COPY deploy/nginx.coolify.conf /etc/nginx/conf.d/default.conf
COPY deploy/api-locations.conf /etc/nginx/api-locations.conf
COPY deploy/api-proxy.conf     /etc/nginx/api-proxy.conf
COPY deploy/log-redaction.conf /etc/nginx/log-redaction.conf

# ─── Que cada `include` apunte a un archivo copiado ─────────────────────────
#
# Un `include` que apunta a un archivo que no se copió (el fallo de arriba) se
# detecta sin nginx: basta comprobar que cada ruta incluida existe. Va antes de
# `nginx -t` para que el mensaje diga qué archivo falta.
RUN set -eu; \
    faltan=0; \
    for f in $(grep -rhoE 'include[[:space:]]+/etc/nginx/[^;]+' \
                 /etc/nginx/conf.d/default.conf /etc/nginx/api-locations.conf \
               | awk '{print $2}' | sort -u); do \
      [ -f "$f" ] || { echo "FALTA el archivo incluido: $f" >&2; faltan=1; }; \
    done; \
    [ "$faltan" -eq 0 ]

# ─── Validación de la configuración en el build ──────────────────────────────
#
# `nginx -t` SÍ sirve aquí. `nginx.coolify.conf` declara los `upstream` con
# `server api:3000 resolve;` y `server web:4000 resolve;` y un
# `resolver 127.0.0.11`, así que nginx no resuelve `api` ni `web` al cargar la
# configuración y la prueba funciona sin red, también dentro del contenedor de
# construcción. (Sin `resolve`, `nginx -t` abortaba con
# `host not found in upstream "api:3000"`; por eso la primera versión de este
# archivo lo descartó.)
#
# Importa porque Coolify despliega este front como docker-compose: apaga el
# contenedor anterior y levanta el nuevo, de modo que un proxy con la
# configuración rota tumba el sitio (`duplicate location` en el bucle de
# reinicio, y un 503 hasta el siguiente despliegue). Lo que sí deja en pie el
# contenedor anterior es que falle el BUILD, y esta línea convierte un error de
# configuración en un fallo de build.
RUN nginx -t

EXPOSE 80

# No pide `/` —que redirige al login— sino la comprobación del propio nginx:
# que el proceso acepta conexiones. Si la que se quiere comprobar es la
# aplicación, ésa la hace el healthcheck del `web`, que es quien la sirve.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/nginx-salud || exit 1
